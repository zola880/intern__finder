# =============================================================================
# BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values before deploying.
# =============================================================================

# Server
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas or self-hosted)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/internfinder?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-this-in-production

# Email (Nodemailer SMTP - for notifications & confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# AI / Groq (chat, CV, cover letter, interview questions)
GROQ_API_KEY=your-groq-api-key

# Cloudinary (optional - for file uploads. Currently using local storage)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Gemini (optional - if you use Google Generative AI)
# GEMINI_API_KEY=your-gemini-api-key

# Allowed CORS origins (comma-separated, no spaces)
# Example: https://your-frontend.vercel.app,https://admin.yourdomain.com
CORS_ORIGINS=https://your-frontend-domain.vercel.app
