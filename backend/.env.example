# =============================================================================
# BACKEND ENVIRONMENT VARIABLES (PostgreSQL)
# Copy this file to .env and fill in your actual values before deploying.
# =============================================================================

# Server
PORT=5000
NODE_ENV=production

# PostgreSQL (local or managed)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/internfinder

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-access-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-this-in-production

# Email (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# AI / Groq
GROQ_API_KEY=your-groq-api-key

# Allowed CORS origins (comma-separated, no spaces)
CORS_ORIGINS=https://your-frontend-domain.vercel.app

# Uploaded company logos and application PDFs are public; CVs are stored separately and served only to authorized users.
# Set both directories to persistent storage paths in production.
UPLOADS_DIR=./uploads
PRIVATE_UPLOADS_DIR=./private_uploads
