# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your actual values before deploying.
# Vite prefix: all variables must start with VITE_ to be exposed to the client.
# =============================================================================

# Backend API base URL (no trailing slash)
# Example: https://your-backend.onrender.com
VITE_API_URL=https://your-backend-domain.onrender.com

# Optional: Gemini API key (if used on the client side)
# VITE_GEMINI_API_KEY=your-gemini-api-key
